rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 認証済みかどうかのチェック
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // リクエストユーザーが自身のデータにのみアクセスできるか
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /portfolios/{portfolioId} {
        allow read, write: if isOwner(uid);
        
        match /holdings/{holdingId} {
          allow read, write: if isOwner(uid);
          
          match /transactions/{transactionId} {
            allow read, write: if isOwner(uid);
          }
        }
      }

      match /newsLogs/{logId} {
        allow read, write: if isOwner(uid);
      }

      match /biasScores/{scoreId} {
        allow read, write: if isOwner(uid);
      }
    }
    
    // PriceHistory等、全ユーザー共通の読み取り専用データがある場合のプレースホルダー
    match /system/priceHistory {
      allow read: if isAuthenticated();
      allow write: if false; // サーバー/Adminからのみ書き込み
    }
  }
}
